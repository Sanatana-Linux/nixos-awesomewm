{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/deepseek-v4-flash:cloud",
  "default_agent": "hubs",
  "permission": {
    "edit": {
      "core/**": "allow",
      "bindings/**": "allow",
      "ui/**": "allow",
      "modules/**": "allow",
      "service/**": "allow",
      "lib/**": "allow",
      "themes/**": "allow",
      "bin/**": "allow",
      "tests/**": "allow",
      ".github/**": "allow",
      "CONTRIBUTING.md": "allow",
      "rc.lua": "allow",
      "rc.lua.test": "allow",
      ".opencode/**": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*"
  ],
  "references": {
    "context": {
      "path": "./.opencode/context",
      "description": "Durable project knowledge base — decisions, patterns, research, frameworks, and theory."
    },
    "x3ric-usr": {
      "repository": "x3ric/usr",
      "description": "Feature-rich AwesomeWM 4.3 config with a large lib/ widget library — reference for widget/utility patterns and flat-file organization."
    }
  }
}

